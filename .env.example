# Password that unlocks editing on the sale page. Editing is disabled if unset.
EDIT_PASSWORD=change-me

# Postgres connection string (Neon / Vercel Postgres).
# Leave empty locally to store items in .data/items.json instead.
DATABASE_URL=

# Vercel Blob token for photo uploads. Set automatically by the Vercel Blob
# integration. Leave empty locally to store uploads in public/uploads/.
BLOB_READ_WRITE_TOKEN=

# Your WhatsApp number, digits only, including country code.
WHATSAPP_NUMBER=48123456789

# Comma-separated "Label|url" pairs shown as payment options.
PAYMENT_LINKS=Revolut|https://revolut.me/yourname,BLIK|https://example.com/blik

# Page copy.
SALE_TITLE=Our moving sale
SALE_INTRO=We are moving. Everything below is up for grabs — tap WhatsApp to claim an item.
SALE_CURRENCY=$
